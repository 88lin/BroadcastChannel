CHANNEL=miantiao_me

LOCALE=zh-CN
TIMEZONE=Asia/Shanghai

SITE_NAME=""
SITE_LOGO=""
SITE_DESCRIPTION=""
# The public site URL is Astro's `site` option, not a .env SITE/SITE_URL variable.
# Set it in astro.config.mjs or build with: pnpm build --site https://example.com

# Build-process variables: set in your hosting environment or shell before building.
# Astro config reads process.env directly; copying these into .env alone is not sufficient.
# SERVER_ADAPTER=node
# Supported adapters: node, vercel, cloudflare_pages, netlify, edgeone.
# DOCKER=true
# Leave DOCKER unset outside container builds; even the string "false" is currently truthy.

TELEGRAM=miantiao_me
TWITTER=miantiao_me
GITHUB=miantiao-me
DISCORD=https://DISCORD.com
PODCAST=https://PODCAST.com
# Legacy fallback when PODCAST is unset; prefer PODCAST for new deployments.
# PODCASRT=https://PODCAST.com
MASTODON=mastodon.social/@Mastodon
BLUESKY=bsky.app

FOOTER_INJECT=
HEADER_INJECT=

SHOW_BANNER=true
BANNER_TEXT=

NOFOLLOW=false
NOINDEX=false
HIDE_DESCRIPTION=false

# Defaults to telegram.me; telegram.dog remains available as an override.
TELEGRAM_HOST=telegram.dog
STATIC_PROXY=""
GOOGLE_SEARCH_SITE=""
TAGS=""
COMMENTS=""
REACTIONS=""
LINKS=""
NAVS=""
RSS_BEAUTIFY=""
FILTER_IMAGES=""
FILTER_FILES=""
AD_KEYWORDS=""
