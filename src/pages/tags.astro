---
import Layout from '../layouts/base.astro'
import Header from '../components/header.astro'
import TagCloudSection from '../components/TagCloudSection.astro'
import { getChannelSummary } from '../lib/telegram'
import { getSelectedChannel, withChannel } from '../lib/channels'
import { getEnv, parseCsvList } from '../lib/env'

const channel = await getChannelSummary(Astro)
const selectedChannel = getSelectedChannel(Astro)
const pageSeo = { title: 'Tags' }
const items = parseCsvList(getEnv(import.meta.env, Astro, 'TAGS')).map((tag) => ({
  href: withChannel(`${Astro.locals.SITE_URL}search/result?q=${encodeURIComponent(`#${tag}`)}`, selectedChannel),
  label: tag,
}))
---

<Layout channel={channel} seo={pageSeo}>
  <Header channel={channel} />

  <TagCloudSection id="tags" title="Tags" items={items} />
</Layout>
