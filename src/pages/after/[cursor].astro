---
import List from '../../components/list.astro'
import { getSelectedChannel, withChannel } from '../../lib/channels'
import { getTimelinePage, isRecoverableTimelineCursorError, isRootTimelineCursor } from '../../lib/telegram'
import type { SeoMeta } from '../../types'

const selectedChannel = getSelectedChannel(Astro)
const timelineHome = withChannel('/', selectedChannel)
if (!Astro.params.cursor) {
  return Astro.redirect(timelineHome)
}

try {
  if (isRootTimelineCursor(Astro.params.cursor, selectedChannel)) {
    return Astro.redirect(timelineHome)
  }
} catch (error) {
  if (isRecoverableTimelineCursorError(error)) {
    return Astro.redirect(timelineHome)
  }
  throw error
}

let channel

try {
  ;({ channel } = await getTimelinePage(Astro, Astro.params.cursor))
} catch (error) {
  if (isRecoverableTimelineCursorError(error)) {
    return Astro.redirect(timelineHome)
  }
  throw error
}

const pageSeo: SeoMeta = {
  noindex: true,
}
---

<List channel={channel} pageHeading={channel.title} pageSeo={pageSeo} />
