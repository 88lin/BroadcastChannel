---
import Header from '../components/header.astro'
import Item from '../components/item.astro'
import ChannelNav from './ChannelNav.astro'
import { getSelectedChannel, withChannel } from '../lib/channels'
import Layout from '../layouts/base.astro'

const { SITE_URL } = Astro.locals
const { channel, before = true, after = true, isItem = false, pageHeading, pageSeo } = Astro.props
const posts = channel.posts ?? []
const selectedChannel = getSelectedChannel(Astro)

const beforeCursor = channel.timeline?.beforeCursor
const afterCursor = channel.timeline?.afterCursor
const itemsClass = 'mt-6 mb-0 grid list-none gap-6 pl-0 [&>li]:min-w-0'
const paginationClass = 'my-5 flex items-center'
const paginationInfoClass = 'flex-1 text-center align-middle text-[12px] font-medium text-muted'
const paginationPlaceholderClass = 'inline-block w-[34px]'
---

<Layout channel={channel} seo={pageSeo}>
  {pageHeading ? <h1 class="sr-only">{pageHeading}</h1> : null}
  <slot name="header">
    <Header channel={channel} />
  </slot>
  {!isItem && <ChannelNav />}
  {
    !posts.length && !isItem && (
      <p class="my-10 text-center text-sm text-muted" role="status">
        {Astro.url.pathname.startsWith('/search')
          ? '没有找到匹配的内容，试试其他关键词或频道。'
          : '暂无可显示的内容，可以切换频道查看。'}
      </p>
    )
  }
  <ol class={itemsClass} aria-label={isItem ? 'Post' : 'Posts'}>
    {
      posts.map((post) => (
        <li>
          <Item post={post} isItem={isItem} />
        </li>
      ))
    }
  </ol>
  <slot />

  <nav class={paginationClass} aria-label="Pagination">
    {
      before && beforeCursor ? (
        <a
          href={withChannel(`${SITE_URL}before/${encodeURIComponent(beforeCursor)}`, selectedChannel)}
          title="Before"
          class="pagination-btn"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6" />
          </svg>
          Before
        </a>
      ) : (
        <span class={paginationPlaceholderClass} aria-hidden="true">
          &nbsp;
        </span>
      )
    }

    <div class={paginationInfoClass}></div>
    {
      after && afterCursor ? (
        <a
          href={withChannel(`${SITE_URL}after/${encodeURIComponent(afterCursor)}`, selectedChannel)}
          title="After"
          class="pagination-btn"
        >
          After
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      ) : (
        <span class={paginationPlaceholderClass} aria-hidden="true">
          &nbsp;
        </span>
      )
    }
  </nav>
</Layout>
